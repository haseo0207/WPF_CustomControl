<Window
    x:Class="Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Demo.Views"
    Title="WPF CustomControl Demo"
    Width="900"
    Height="600">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  좌측 네비게이션  -->
        <ListBox
            x:Name="NavList"
            Grid.Column="0"
            Padding="8"
            Background="#F8F8F8"
            BorderThickness="0"
            SelectedIndex="0"
            SelectionChanged="NavList_SelectionChanged">
            <ListBoxItem Padding="8,6" Content="RoundedComboBox" />
            <ListBoxItem Padding="8,6" Content="ScrollBar" />
            <ListBoxItem Padding="8,6" Content="RoundedCheckBox" />
            <ListBoxItem Padding="8,6" Content="RoundedListView" />
        </ListBox>

        <!--  구분선  -->
        <Border Grid.Column="1" Background="#E0E0E0" />

        <!--  우측 콘텐츠  -->
        <ContentControl x:Name="ContentArea" Grid.Column="2" />
    </Grid>
</Window>
