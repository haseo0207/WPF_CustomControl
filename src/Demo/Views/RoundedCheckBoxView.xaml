<UserControl
    x:Class="Demo.Views.RoundedCheckBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:CustomControls.Components;assembly=CustomControls">

    <StackPanel
        Width="300"
        Margin="20"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

        <TextBlock
            Margin="0,0,0,16"
            FontSize="16"
            FontWeight="SemiBold"
            Text="RoundedCheckBox" />

        <cc:RoundedCheckBox Margin="0,6" Content="Default (Unchecked)" />
        <cc:RoundedCheckBox
            Margin="0,6"
            Content="Checked"
            IsChecked="True" />
        <cc:RoundedCheckBox
            Margin="0,6"
            Content="Indeterminate"
            IsChecked="{x:Null}"
            IsThreeState="True" />
        <cc:RoundedCheckBox
            Margin="0,6"
            Content="Disabled"
            IsEnabled="False" />
        <cc:RoundedCheckBox
            Margin="0,6"
            Content="Disabled + Checked"
            IsChecked="True"
            IsEnabled="False" />

        <Separator Margin="0,16" />

        <TextBlock
            Margin="0,0,0,10"
            Foreground="#666666"
            Text="Custom Size (BoxSize=24, CornerRadius=6)" />
        <cc:RoundedCheckBox
            BoxSize="24"
            Content="Large CheckBox"
            CornerRadius="6"
            FontSize="14" />
    </StackPanel>
</UserControl>
