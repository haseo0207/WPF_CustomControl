<UserControl
    x:Class="Demo.Views.ScrollBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel
        Width="400"
        Margin="20"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

        <TextBlock
            Margin="0,0,0,16"
            FontSize="16"
            FontWeight="SemiBold"
            Text="ScrollBar" />

        <!--  스크롤 가능한 리스트로 Vertical ScrollBar 확인  -->
        <TextBlock
            Margin="0,0,0,6"
            Foreground="#666666"
            Text="Vertical ScrollBar" />
        <Border
            Height="180"
            BorderBrush="#CCCCCC"
            BorderThickness="1"
            CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Visible">
                <StackPanel Margin="10,6">
                    <TextBlock Margin="0,4" Text="Item 1" />
                    <TextBlock Margin="0,4" Text="Item 2" />
                    <TextBlock Margin="0,4" Text="Item 3" />
                    <TextBlock Margin="0,4" Text="Item 4" />
                    <TextBlock Margin="0,4" Text="Item 5" />
                    <TextBlock Margin="0,4" Text="Item 6" />
                    <TextBlock Margin="0,4" Text="Item 7" />
                    <TextBlock Margin="0,4" Text="Item 8" />
                    <TextBlock Margin="0,4" Text="Item 9" />
                    <TextBlock Margin="0,4" Text="Item 10" />
                    <TextBlock Margin="0,4" Text="Item 11" />
                    <TextBlock Margin="0,4" Text="Item 12" />
                    <TextBlock Margin="0,4" Text="Item 13" />
                    <TextBlock Margin="0,4" Text="Item 14" />
                    <TextBlock Margin="0,4" Text="Item 15" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  넓은 콘텐츠로 Horizontal ScrollBar 확인  -->
        <TextBlock
            Margin="0,20,0,6"
            Foreground="#666666"
            Text="Horizontal ScrollBar" />
        <Border
            Height="80"
            BorderBrush="#CCCCCC"
            BorderThickness="1"
            CornerRadius="4">
            <ScrollViewer HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Disabled">
                <TextBlock
                    Width="800"
                    Margin="10"
                    Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris."
                    TextWrapping="NoWrap" />
            </ScrollViewer>
        </Border>
    </StackPanel>
</UserControl>
