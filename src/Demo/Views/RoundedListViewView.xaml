<UserControl x:Class="Demo.Views.RoundedListViewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Demo.ViewModels">

    <UserControl.DataContext>
        <vm:RoundedListViewViewModel />
    </UserControl.DataContext>

    <StackPanel Width="500"
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

        <TextBlock Margin="0,0,0,16"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="RoundedListView" />

        <ListView ItemsSource="{Binding Items}" 
                  Style="{StaticResource RoundedListViewStyle}">
            <ListView.View>
                <GridView AllowsColumnReorder="False"
                          ColumnHeaderContainerStyle="{StaticResource RoundedListViewColumnHeader}">
                    <GridViewColumn Width="160"
                                    DisplayMemberBinding="{Binding BoxNumber}"
                                    Header="박스 번호" />
                    <GridViewColumn Width="160"
                                    DisplayMemberBinding="{Binding Location}"
                                    Header="위치" />
                    <GridViewColumn Width="140" 
                                    DisplayMemberBinding="{Binding BoxStatus}"
                                    Header="박스 상태" />
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</UserControl>
