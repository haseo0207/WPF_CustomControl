<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!--  #1. Frozen Geometry Resources  -->
    <Geometry x:Key="ScrollBarUpArrowGeometry"
              po:Freeze="True">M 0 4 L 4 0 L 8 4 Z</Geometry>
    <Geometry x:Key="ScrollBarDownArrowGeometry"
              po:Freeze="True">M 0 0 L 4 4 L 8 0 Z</Geometry>
    <Geometry x:Key="ScrollBarLeftArrowGeometry"
              po:Freeze="True">M 4 0 L 0 4 L 4 8 Z</Geometry>
    <Geometry x:Key="ScrollBarRightArrowGeometry"
              po:Freeze="True">M 0 0 L 4 4 L 0 8 Z</Geometry>

    <!--  #1. Frozen Brush Resources  -->
    <SolidColorBrush x:Key="ScrollBarArrowBrush"
                     po:Freeze="True"
                     Color="#999999" />
    <SolidColorBrush x:Key="ScrollBarArrowHoverBrush"
                     po:Freeze="True"
                     Color="#666666" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush"
                     po:Freeze="True"
                     Color="#C0C0C0" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush"
                     po:Freeze="True"
                     Color="#A0A0A0" />
    <SolidColorBrush x:Key="ScrollBarThumbPressedBrush"
                     po:Freeze="True"
                     Color="#808080" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush"
                     po:Freeze="True"
                     Color="#F0F0F0" />

    <!--  #2. Disabled 상태용 Brush (Brush.Opacity 적용)  -->
    <SolidColorBrush x:Key="ScrollBarArrowDisabledBrush"
                     po:Freeze="True"
                     Opacity="0.3"
                     Color="#999999" />
    <SolidColorBrush x:Key="ScrollBarTrackDisabledBrush"
                     po:Freeze="True"
                     Opacity="0.3"
                     Color="#F0F0F0" />

    <!--  ScrollBar Arrow Button (Up/Down/Left/Right)  -->
    <Style x:Key="ScrollBarLineButtonStyle"
           TargetType="RepeatButton">
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <!--  #4. RepeatButton Delay/Interval 명시  -->
        <Setter Property="Delay"
                Value="300" />
        <Setter Property="Interval"
                Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="Border"
                            Width="8"
                            Height="14"
                            Background="Transparent"
                            CornerRadius="4">
                        <Path x:Name="Arrow"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                              Fill="{StaticResource ScrollBarArrowBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Arrow"
                                    Property="Fill"
                                    Value="{StaticResource ScrollBarArrowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="Arrow"
                                    Property="Fill"
                                    Value="{StaticResource ScrollBarThumbPressedBrush}" />
                        </Trigger>
                        <!--  #2. Brush.Opacity로 Disabled 표현  -->
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="Arrow"
                                    Property="Fill"
                                    Value="{StaticResource ScrollBarArrowDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ScrollBar Page Button (Track empty area)  -->
    <Style x:Key="ScrollBarPageButtonStyle"
           TargetType="RepeatButton">
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="IsTabStop"
                Value="False" />
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ScrollBar Thumb  -->
    <Style x:Key="ScrollBarThumbStyle"
           TargetType="Thumb">
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="IsTabStop"
                Value="False" />
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder"
                            Background="{StaticResource ScrollBarThumbBrush}"
                            CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ThumbBorder"
                                    Property="Background"
                                    Value="{StaticResource ScrollBarThumbHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging"
                                 Value="True">
                            <Setter TargetName="ThumbBorder"
                                    Property="Background"
                                    Value="{StaticResource ScrollBarThumbPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Vertical ScrollBar ControlTemplate  -->
    <ControlTemplate x:Key="VerticalScrollBarTemplate"
                     TargetType="ScrollBar">
        <Border x:Name="TrackBorder"
                Background="{StaticResource ScrollBarTrackBrush}"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Up Arrow  -->
                <RepeatButton Grid.Row="0"
                              Margin="0,2"
                              HorizontalAlignment="Center"
                              Command="ScrollBar.LineUpCommand"
                              Content="{StaticResource ScrollBarUpArrowGeometry}"
                              Style="{StaticResource ScrollBarLineButtonStyle}" />

                <!--  Track  -->
                <Track x:Name="PART_Track"
                       Grid.Row="1"
                       IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                      Style="{StaticResource ScrollBarPageButtonStyle}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb MinHeight="20"
                               Margin="3,0"
                               Style="{StaticResource ScrollBarThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                      Style="{StaticResource ScrollBarPageButtonStyle}" />
                    </Track.IncreaseRepeatButton>
                </Track>

                <!--  Down Arrow  -->
                <RepeatButton Grid.Row="2"
                              Margin="0,2"
                              HorizontalAlignment="Center"
                              Command="ScrollBar.LineDownCommand"
                              Content="{StaticResource ScrollBarDownArrowGeometry}"
                              Style="{StaticResource ScrollBarLineButtonStyle}" />
            </Grid>
        </Border>
        <!--  #2. Disabled: Brush.Opacity로 표현  -->
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled"
                     Value="False">
                <Setter TargetName="TrackBorder"
                        Property="Background"
                        Value="{StaticResource ScrollBarTrackDisabledBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  Horizontal ScrollBar ControlTemplate  -->
    <ControlTemplate x:Key="HorizontalScrollBarTemplate"
                     TargetType="ScrollBar">
        <Border x:Name="TrackBorder"
                Background="{StaticResource ScrollBarTrackBrush}"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Left Arrow  -->
                <RepeatButton Grid.Column="0"
                              Margin="2,0"
                              VerticalAlignment="Center"
                              Command="ScrollBar.LineLeftCommand"
                              Content="{StaticResource ScrollBarLeftArrowGeometry}"
                              Style="{StaticResource ScrollBarLineButtonStyle}" />

                <!--  Track  -->
                <!--  #5. IsDirectionReversed="False" 명시  -->
                <Track x:Name="PART_Track"
                       Grid.Column="1"
                       IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand"
                                      Style="{StaticResource ScrollBarPageButtonStyle}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb MinWidth="20"
                               Margin="0,3"
                               Style="{StaticResource ScrollBarThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand"
                                      Style="{StaticResource ScrollBarPageButtonStyle}" />
                    </Track.IncreaseRepeatButton>
                </Track>

                <!--  Right Arrow  -->
                <RepeatButton Grid.Column="2"
                              Margin="2,0"
                              VerticalAlignment="Center"
                              Command="ScrollBar.LineRightCommand"
                              Content="{StaticResource ScrollBarRightArrowGeometry}"
                              Style="{StaticResource ScrollBarLineButtonStyle}" />
            </Grid>
        </Border>
        <!--  #2. Disabled: Brush.Opacity로 표현  -->
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled"
                     Value="False">
                <Setter TargetName="TrackBorder"
                        Property="Background"
                        Value="{StaticResource ScrollBarTrackDisabledBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  ScrollBar Style (implicit - applies globally)  -->
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="UseLayoutRounding"
                Value="True" />
        <Style.Triggers>
            <Trigger Property="Orientation"
                     Value="Vertical">
                <Setter Property="Width"
                        Value="14" />
                <Setter Property="MinWidth"
                        Value="14" />
                <Setter Property="Template"
                        Value="{StaticResource VerticalScrollBarTemplate}" />
            </Trigger>
            <Trigger Property="Orientation"
                     Value="Horizontal">
                <Setter Property="Height"
                        Value="14" />
                <Setter Property="MinHeight"
                        Value="14" />
                <Setter Property="Template"
                        Value="{StaticResource HorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
