<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cc="clr-namespace:CustomControls.Components"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!--  #3. Frozen Brush Resources  -->
    <SolidColorBrush x:Key="RoundedComboBox.Foreground"
                     po:Freeze="True"
                     Color="#333333" />
    <SolidColorBrush x:Key="RoundedComboBox.Background"
                     po:Freeze="True"
                     Color="White" />
    <SolidColorBrush x:Key="RoundedComboBox.BorderBrush"
                     po:Freeze="True"
                     Color="#CCCCCC" />
    <SolidColorBrush x:Key="RoundedComboBox.Highlight"
                     po:Freeze="True"
                     Color="#3D5A99" />
    <SolidColorBrush x:Key="RoundedComboBox.Accent"
                     po:Freeze="True"
                     Color="#4A6CF7" />
    <SolidColorBrush x:Key="RoundedComboBox.Arrow"
                     po:Freeze="True"
                     Color="#555555" />
    <SolidColorBrush x:Key="RoundedComboBox.Disabled.Foreground"
                     po:Freeze="True"
                     Opacity="0.5"
                     Color="#333333" />
    <SolidColorBrush x:Key="RoundedComboBox.Disabled.Background"
                     po:Freeze="True"
                     Opacity="0.5"
                     Color="White" />
    <SolidColorBrush x:Key="RoundedComboBox.Disabled.BorderBrush"
                     po:Freeze="True"
                     Opacity="0.5"
                     Color="#CCCCCC" />

    <!--  Toggle Button (ComboBox 본체)  -->
    <ControlTemplate x:Key="RoundedComboBoxToggleButton"
                     TargetType="{x:Type ToggleButton}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>

            <Border x:Name="Border"
                    Grid.ColumnSpan="2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type cc:RoundedComboBox}}}" />

            <!--  Arrow  -->
            <Path x:Name="Arrow"
                  Grid.Column="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Data="M 0 0 L 5 5 L 10 0"
                  Fill="Transparent"
                  Stroke="{StaticResource RoundedComboBox.Arrow}"
                  StrokeThickness="1.5" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked"
                     Value="True">
                <Setter TargetName="Arrow"
                        Property="Data"
                        Value="M 0 5 L 5 0 L 10 5" />
            </Trigger>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter TargetName="Border"
                        Property="BorderBrush"
                        Value="{StaticResource RoundedComboBox.Accent}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  ComboBoxItem Style  -->
    <Style x:Key="RoundedComboBoxItem"
           TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Padding"
                Value="10,8" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{StaticResource RoundedComboBox.Foreground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource RoundedComboBox.Highlight}" />
                            <Setter Property="Foreground"
                                    Value="White" />
                        </Trigger>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource RoundedComboBox.Highlight}" />
                            <Setter Property="Foreground"
                                    Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  RoundedComboBox Style  -->
    <Style TargetType="{x:Type cc:RoundedComboBox}">
        <Setter Property="Foreground"
                Value="{StaticResource RoundedComboBox.Foreground}" />
        <Setter Property="Background"
                Value="{StaticResource RoundedComboBox.Background}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource RoundedComboBox.BorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Padding"
                Value="10,8" />
        <Setter Property="MinHeight"
                Value="36" />
        <Setter Property="CornerRadius"
                Value="6" />
        <Setter Property="PopupCornerRadius"
                Value="6" />
        <Setter Property="ItemContainerStyle"
                Value="{StaticResource RoundedComboBoxItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll"
                Value="True" />
        <!--  #2. UseLayoutRounding: 레이아웃 단계에서 픽셀 정렬 (SnapsToDevicePixels 대체)  -->
        <Setter Property="UseLayoutRounding"
                Value="True" />
        <!--  #4. VirtualizingStackPanel 명시  -->
        <Setter Property="VirtualizingStackPanel.IsVirtualizing"
                Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode"
                Value="Recycling" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type cc:RoundedComboBox}">
                    <Grid x:Name="templateRoot">
                        <!--  ToggleButton: 전체 영역  -->
                        <ToggleButton x:Name="toggleButton"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      ClickMode="Press"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Template="{StaticResource RoundedComboBoxToggleButton}" />

                        <!--  선택된 항목 표시  -->
                        <ContentPresenter x:Name="contentPresenter"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          IsHitTestVisible="False" />

                        <!--  Popup (드롭다운 리스트)  -->
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom"
                               PopupAnimation="Slide"
                               VerticalOffset="4">
                            <Grid x:Name="dropDownGrid"
                                  MinWidth="{Binding ActualWidth, ElementName=templateRoot}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">

                                <!--  드롭다운 외곽: 둥근 모서리 + 그림자  -->
                                <Border x:Name="dropDownBorder"
                                        Background="{StaticResource RoundedComboBox.Background}"
                                        BorderBrush="{StaticResource RoundedComboBox.BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{Binding PopupCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type cc:RoundedComboBox}}}">
                                    <Border.Effect>
                                        <!--  #5. RenderingBias="Performance"  -->
                                        <DropShadowEffect BlurRadius="8"
                                                          Direction="270"
                                                          Opacity="0.15"
                                                          RenderingBias="Performance"
                                                          ShadowDepth="2"
                                                          Color="Black" />
                                    </Border.Effect>
                                </Border>

                                <!--  리스트 영역: 둥근 모서리에 맞게 클리핑  -->
                                <Border Margin="1"
                                        CornerRadius="{Binding PopupCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type cc:RoundedComboBox}}}">
                                    <Border.Clip>
                                        <MultiBinding Converter="{x:Static cc:BorderClipConverter.Instance}">
                                            <Binding Path="ActualWidth"
                                                     RelativeSource="{RelativeSource Self}" />
                                            <Binding Path="ActualHeight"
                                                     RelativeSource="{RelativeSource Self}" />
                                            <Binding Path="CornerRadius"
                                                     RelativeSource="{RelativeSource Self}" />
                                        </MultiBinding>
                                    </Border.Clip>
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <ItemsPresenter x:Name="ItemsPresenter"
                                                        KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen"
                                 Value="True">
                            <Setter TargetName="toggleButton"
                                    Property="BorderBrush"
                                    Value="{StaticResource RoundedComboBox.Accent}" />
                        </Trigger>
                        <!--  #6. Opacity → Brush.Opacity (요소 전체 Opacity 대신 개별 Brush 교체)  -->
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Foreground"
                                    Value="{StaticResource RoundedComboBox.Disabled.Foreground}" />
                            <Setter TargetName="toggleButton"
                                    Property="Background"
                                    Value="{StaticResource RoundedComboBox.Disabled.Background}" />
                            <Setter TargetName="toggleButton"
                                    Property="BorderBrush"
                                    Value="{StaticResource RoundedComboBox.Disabled.BorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
