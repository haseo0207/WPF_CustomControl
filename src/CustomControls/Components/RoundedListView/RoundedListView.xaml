<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:CustomControls.Components"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!--  Frozen Resources  -->
    <SolidColorBrush
        x:Key="RoundedListView.Background"
        po:Freeze="True"
        Color="White" />
    <SolidColorBrush
        x:Key="RoundedListView.BorderBrush"
        po:Freeze="True"
        Color="#E8E8E8" />
    <SolidColorBrush
        x:Key="RoundedListView.HeaderForeground"
        po:Freeze="True"
        Color="#999999" />
    <SolidColorBrush
        x:Key="RoundedListView.RowBorderBrush"
        po:Freeze="True"
        Color="#F0F0F0" />
    <SolidColorBrush
        x:Key="RoundedListView.ItemForeground"
        po:Freeze="True"
        Color="#333333" />
    <SolidColorBrush
        x:Key="RoundedListView.HeaderBackground"
        po:Freeze="True"
        Color="#F7F7F8" />

    <!--  GridViewColumnHeader Style  -->
    <Style x:Key="RoundedListViewColumnHeader" TargetType="{x:Type GridViewColumnHeader}">
        <Setter Property="Background" Value="{StaticResource RoundedListView.HeaderBackground}" />
        <Setter Property="Foreground" Value="{StaticResource RoundedListView.HeaderForeground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ListViewItem Style  -->
    <Style x:Key="RoundedListViewItem" TargetType="{x:Type ListViewItem}">
        <Setter Property="Foreground" Value="{StaticResource RoundedListView.ItemForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{StaticResource RoundedListView.RowBorderBrush}"
                        BorderThickness="0,1,0,0">
                        <GridViewRowPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  RoundedListView Style (Style-only, no CustomControl)  -->
    <Style x:Key="RoundedListViewStyle" TargetType="{x:Type ListView}">
        <Setter Property="Background" Value="{StaticResource RoundedListView.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource RoundedListView.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource RoundedListViewItem}" />
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListView}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                        <!--  헤더 배경이 둥근 모서리 밖으로 넘치지 않도록 클리핑  -->
                        <Border CornerRadius="7">
                            <Border.Clip>
                                <MultiBinding Converter="{x:Static cc:BorderClipConverter.Instance}">
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="CornerRadius" RelativeSource="{RelativeSource Self}" />
                                </MultiBinding>
                            </Border.Clip>
                            <DockPanel>
                                <!--  #1. GridViewHeaderRowPresenter 바인딩 보완  -->
                                <GridViewHeaderRowPresenter
                                    AllowsColumnReorder="{Binding Path=View.AllowsColumnReorder, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderContainerStyle="{Binding Path=View.ColumnHeaderContainerStyle, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderContextMenu="{Binding Path=View.ColumnHeaderContextMenu, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderTemplate="{Binding Path=View.ColumnHeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderToolTip="{Binding Path=View.ColumnHeaderToolTip, RelativeSource={RelativeSource TemplatedParent}}"
                                    Columns="{Binding Path=View.Columns, RelativeSource={RelativeSource TemplatedParent}}"
                                    DockPanel.Dock="Top" />
                                <!--  행 리스트  -->
                                <ScrollViewer Focusable="False">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
