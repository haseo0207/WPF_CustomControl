<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:CustomControls.Components"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <SolidColorBrush
        x:Key="Pagination.Arrow.Background"
        po:Freeze="True"
        Color="#E8F0F2" />
    <SolidColorBrush
        x:Key="Pagination.Arrow.Foreground"
        po:Freeze="True"
        Color="#5BA9B5" />
    <SolidColorBrush
        x:Key="Pagination.Arrow.Hover.Background"
        po:Freeze="True"
        Color="#D0E6EB" />
    <SolidColorBrush
        x:Key="Pagination.Arrow.Disabled.Background"
        po:Freeze="True"
        Color="#F0F0F0" />
    <SolidColorBrush
        x:Key="Pagination.Arrow.Disabled.Foreground"
        po:Freeze="True"
        Color="#C0C0C0" />
    <SolidColorBrush
        x:Key="Pagination.Page.Background"
        po:Freeze="True"
        Color="#FFFFFF" />
    <SolidColorBrush
        x:Key="Pagination.Page.Foreground"
        po:Freeze="True"
        Color="#333333" />
    <SolidColorBrush
        x:Key="Pagination.Page.Hover.Background"
        po:Freeze="True"
        Color="#F0F0F0" />
    <SolidColorBrush
        x:Key="Pagination.Page.Border"
        po:Freeze="True"
        Color="#E0E0E0" />
    <SolidColorBrush
        x:Key="Pagination.Current.Background"
        po:Freeze="True"
        Color="#C04050" />
    <SolidColorBrush
        x:Key="Pagination.Current.Foreground"
        po:Freeze="True"
        Color="#FFFFFF" />
    <SolidColorBrush
        x:Key="Pagination.Ellipsis.Foreground"
        po:Freeze="True"
        Color="#999999" />

    <!--  Arrow Button Style (Prev / Next)  -->
    <Style x:Key="PaginationArrowButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Pagination.Arrow.Foreground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="Border"
                        Background="{StaticResource Pagination.Arrow.Background}"
                        BorderBrush="{StaticResource Pagination.Page.Border}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource Pagination.Arrow.Hover.Background}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource Pagination.Arrow.Disabled.Background}" />
                            <Setter Property="Foreground" Value="{StaticResource Pagination.Arrow.Disabled.Foreground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Pagination ControlTemplate  -->
    <Style TargetType="{x:Type cc:Pagination}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type cc:Pagination}">
                    <StackPanel Orientation="Horizontal">
                        <!--  Previous Button  -->
                        <Button
                            Margin="0,0,4,0"
                            Command="{x:Static cc:Pagination.PreviousPageCommand}"
                            Content="&#x276E;"
                            Style="{StaticResource PaginationArrowButton}" />

                        <!--  Page Buttons  -->
                        <ItemsControl ItemsSource="{TemplateBinding PageItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type cc:PageItem}">
                                    <Button
                                        Height="36"
                                        MinWidth="36"
                                        Margin="2,0"
                                        Padding="8,0"
                                        Command="{x:Static cc:Pagination.GoToPageCommand}"
                                        CommandParameter="{Binding PageNumber, Mode=OneTime}"
                                        Cursor="Hand"
                                        FontSize="14">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border
                                                    x:Name="Border"
                                                    Background="{StaticResource Pagination.Page.Background}"
                                                    BorderBrush="{StaticResource Pagination.Page.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        x:Name="Text"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        Foreground="{StaticResource Pagination.Page.Foreground}"
                                                        Text="{Binding Display, Mode=OneTime}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="{StaticResource Pagination.Page.Hover.Background}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsCurrent, Mode=OneTime}" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="{StaticResource Pagination.Current.Background}" />
                                                        <Setter TargetName="Border" Property="BorderThickness" Value="0" />
                                                        <Setter TargetName="Border" Property="Padding" Value="1" />
                                                        <Setter TargetName="Text" Property="Foreground" Value="{StaticResource Pagination.Current.Foreground}" />
                                                        <Setter TargetName="Text" Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEllipsis, Mode=OneTime}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Cursor" Value="Arrow" />
                                                        <Setter TargetName="Text" Property="Foreground" Value="{StaticResource Pagination.Ellipsis.Foreground}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Next Button  -->
                        <Button
                            Margin="4,0,0,0"
                            Command="{x:Static cc:Pagination.NextPageCommand}"
                            Content="&#x276F;"
                            Style="{StaticResource PaginationArrowButton}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
